# Google AI Studio key (https://aistudio.google.com/apikey). Covers the prompt refiner and Nano Banana.
GEMINI_API_KEY=

# From @BotFather. Then /setprivacy -> Disable, so the bot can read feedback in groups.
TELEGRAM_TOKEN=

# Telegram user ids allowed to use the bot (send /chatid to the bot to see yours).
ALLOWED_USER_IDS=111111111,222222222

# Which brand each Telegram group belongs to: <chat_id>:<brand>, comma separated.
CHAT_BRANDS=-1001111111111:golden,-1002222222222:cassis

# Optional overrides
# IMAGE_MODEL=gemini-nano-banana-2.1   # gemini-3-pro-image for Nano Banana Pro
# TEXT_MODEL=gemini-3.8-flash
# DRAFT_SIZE=2K                        # 1K is cheaper/faster, 4K is slowest/most expensive
# PROPOSALS=2
